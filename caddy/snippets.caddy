# Shared Caddy snippets. In a project Caddyfile:
#   import /common/caddy/snippets.caddy
#   …
#   handle /api/* {
#     import lb api 8080
#   }

# Balance across every replica of a compose service. Caddy looks the name up through
# Docker DNS every 5 s, so `--scale <service>=N` needs no config change. A plain
# `reverse_proxy api:8080` would be one upstream and would not spread load reliably.
(lb) {
	reverse_proxy {
		dynamic a {
			name {args[0]}
			port {args[1]}
			refresh 5s
		}
		lb_policy round_robin
		fail_duration 10s
		lb_try_duration 5s
		header_up X-Request-Id {http.request.uuid}
	}
}
